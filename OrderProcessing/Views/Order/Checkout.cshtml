@model OrderProcessing.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Checkout";
}

<div class="container py-5">

    <div class="card shadow-lg border-0 rounded-4">

        <div class="card-header bg-success text-white p-4">

            <h2 class="mb-0">
                Checkout
            </h2>

        </div>

        <div class="card-body">

            <form asp-controller="Order"
                  asp-action="Checkout"
                  method="post">

                <div class="mb-4">

                    <label class="form-label fw-bold">
                        Customer Name
                    </label>

                    <input asp-for="CustomerName"
                           class="form-control form-control-lg" />

                    <span asp-validation-for="CustomerName"
                          class="text-danger"></span>

                </div>

                <table class="table table-bordered table-hover align-middle">

                    <thead class="table-primary">

                        <tr>

                            <th>Product</th>
                            <th>Price</th>
                            <th>Stock</th>
                            <th width="140">Quantity</th>

                        </tr>

                    </thead>

                    <tbody>

                        @for (int i = 0; i < Model.Items.Count; i++)
                        {
                            <tr>

                                <td>

                                    @Model.Items[i].ProductName

                                    <input type="hidden" asp-for="Items[i].ProductId" />
                                    <input type="hidden" asp-for="Items[i].ProductName" />
                                    <input type="hidden" asp-for="Items[i].Price" />
                                    <input type="hidden" asp-for="Items[i].Stock" />

                                </td>

                                <td class="fw-bold text-success">
                                    ₹@Model.Items[i].Price
                                </td>

                                <td>

                                    <span class="badge bg-info">
                                        @Model.Items[i].Stock
                                    </span>

                                </td>

                                <td>

                                    <input asp-for="Items[i].Quantity"
                                           class="form-control text-center"
                                           min="0" />

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

                <button class="btn btn-success btn-lg w-100">

                    Place Order

                </button>

            </form>

        </div>

    </div>

</div>