@{
}
@model OrderProcessing.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Confirm Order";

    decimal total = Model.Items.Sum(x => x.Price * x.Quantity);
    decimal discount = total * Model.DiscountPercentage / 100;
    decimal finalTotal = total - discount;
}

<div class="container mt-4">
    <h2>Confirm Order</h2>

    <form asp-controller="Order" asp-action="Confirm" method="post">

        <input type="hidden" asp-for="CustomerName" />

        <p><strong>Customer Name:</strong> @Model.CustomerName</p>

        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Amount</th>
                </tr>
            </thead>

            <tbody>
                @for (int i = 0; i < Model.Items.Count; i++)
                {
                    var amount = Model.Items[i].Price * Model.Items[i].Quantity;

                    <tr>
                        <td>
                            @Model.Items[i].ProductName

                            <input type="hidden" asp-for="Items[i].ProductId" />
                            <input type="hidden" asp-for="Items[i].ProductName" />
                            <input type="hidden" asp-for="Items[i].Price" />
                            <input type="hidden" asp-for="Items[i].Stock" />
                            <input type="hidden" asp-for="Items[i].Quantity" />
                        </td>

                        <td>₹@Model.Items[i].Price</td>
                        <td>@Model.Items[i].Quantity</td>
                        <td>₹@amount</td>
                    </tr>
                }
            </tbody>
        </table>

      
        <div >

            <p><strong>Total:</strong> ₹<span id="total">@total</span></p>

            <div >
                <label>Discount (%)</label>
                <input asp-for="DiscountPercentage"
                       type="number"
                       id="discountPercentage"
                       class="form-control"
                      />
            </div>

            <p>
                <strong>Discount:</strong>
                ₹<span id="discountAmount">@discount</span>
            </p>

            <h4>
                <strong>Final Amount:</strong>
                ₹<span id="finalAmount">@finalTotal</span>
            </h4>

        </div>
        <button type="submit" class="btn btn-success mt-3">
            Confirm & Place Order
        </button>

        <a asp-controller="Order" asp-action="Checkout" class="btn btn-secondary mt-3">
            Back
        </a>

    </form>
</div>
<script>

    document.getElementById("discountPercentage").addEventListener("input", function () {

        var total = @total;

        var percentage = parseFloat(this.value) || 0;

        var discount = (total * percentage) / 100;

        var finalAmount = total - discount;

        document.getElementById("discountAmount").innerText = discount.toFixed(2);

        document.getElementById("finalAmount").innerText = finalAmount.toFixed(2);

    });

</script>